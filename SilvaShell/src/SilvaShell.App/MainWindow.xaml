<Window x:Class="SilvaShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Silva Shell" Height="800" Width="1300"
        KeyDown="Window_KeyDown"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="CloseCommand_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save Workspace" Click="SaveWorkspaceMenuItem_Click"/>
                <MenuItem Header="_Load Workspace" Click="LoadWorkspaceMenuItem_Click"/>
                <MenuItem Header="_Manage Workspaces" Click="ManageWorkspacesMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Command="ApplicationCommands.Close"/>
            </MenuItem>
            <MenuItem Header="_Plugins" x:Name="PluginsMenu">
                <MenuItem Header="_Manage Plugins" Click="ManagePluginsMenuItem_Click"/>
                <Separator/>
            </MenuItem>
            <MenuItem Header="_Themes" x:Name="ThemesMenu">
                <MenuItem Header="_Light Theme" Click="LightThemeMenuItem_Click"/>
                <MenuItem Header="_Dark Theme" Click="DarkThemeMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Blue Ocean Theme" Click="BlueThemeMenuItem_Click"/>
                <MenuItem Header="_Forest Green Theme" Click="ForestThemeMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Custom Theme..." Click="CustomThemeMenuItem_Click"/>
                <MenuItem Header="_Manage Themes..." Click="ManageThemesMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Notifications">
                <MenuItem Header="_View Notifications" Click="ViewNotificationsMenuItem_Click"/>
                <MenuItem Header="_Test Notification" Click="TestNotificationMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Mark All Read" Click="MarkAllReadMenuItem_Click"/>
                <MenuItem Header="_Clear All" Click="ClearAllNotificationsMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Grid.Column="1" Padding="10" Background="{DynamicResource ThemeSecondaryBrush}">
            <DockPanel>
                <StackPanel x:Name="PluginToolbarArea" DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GlobalSearchBox"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             FontSize="14"
                             KeyDown="GlobalSearchBox_KeyDown"
                             Background="{DynamicResource ThemeBackgroundBrush}"
                             Foreground="{DynamicResource ThemeForegroundBrush}"/>
                    <Button Grid.Column="1"
                            Content="🔍 Search All Tabs"
                            Width="120"
                            Margin="10,0,0,0"
                            Click="GlobalSearchBtn_Click"
                            Background="{DynamicResource ThemePrimaryBrush}"
                            Foreground="White"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Sidebar -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" x:Name="SidebarPanel" Background="{DynamicResource ThemeSidebarBackgroundBrush}" MinWidth="50">
            <Button x:Name="ToggleSidebarBtn"
                    DockPanel.Dock="Top"
                    Content="◀"
                    Height="30"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Click="ToggleSidebarBtn_Click"/>
            <Button x:Name="AddAppBtn"
                    DockPanel.Dock="Bottom"
                    Content="+ Add App"
                    Margin="8,0,8,8"
                    Height="30"
                    Background="#333333"
                    Foreground="White"
                    BorderThickness="0"
                    Click="AddAppBtn_Click"/>
            <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SidebarContentPanel" Margin="8"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Grid.Column="1"
                    TabStripPlacement="Top"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        BorderThickness="1,1,0,0"
                                        BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                                        CornerRadius="4,4,0,0"
                                        Margin="2,0,-2,0"
                                        Background="{DynamicResource ThemeSecondaryBrush}"
                                        Opacity="0.7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TabTitle"
                                                   Grid.Column="1"
                                                   Text="{TemplateBinding Header}"
                                                   Margin="8,4"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ThemeForegroundBrush}"/>
                                        <Button x:Name="CloseButton"
                                                Grid.Column="2"
                                                Content="✕"
                                                Width="20"
                                                Height="20"
                                                Margin="4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="10"
                                                Foreground="{DynamicResource ThemeForegroundBrush}"
                                                Click="CloseTabButton_Click"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
                                        <Setter TargetName="Border" Property="Opacity" Value="1.0"/>
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Default welcome tab -->
            <TabItem Header="Welcome" x:Name="WelcomeTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="SilvaShell"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ThemePrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Your Advanced AI &amp; Communication Desktop"
                                   FontSize="18"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   Margin="0,10,0,30"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8"/>
                        <TextBlock Text="Click on any app in the sidebar to get started!"
                                   FontSize="14"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"/>
                    </StackPanel>

                    <!-- Global controls (always visible) -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <!-- TTS controls -->
                        <ComboBox x:Name="VoiceSelector"
                                  Width="260"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,8,0"/>
                        <Button Content="Speak Selection"
                                Click="SpeakSelection_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</DockPanel>
</Window>
