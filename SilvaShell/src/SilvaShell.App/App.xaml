<Application x:Class="SilvaShell.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SilvaShell.App.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter"/>
        <local:NotificationTypeToColorConverter x:Key="NotificationTypeToColorConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Theme Brushes -->
        <SolidColorBrush x:Key="ThemePrimaryBrush" Color="Blue"/>
        <SolidColorBrush x:Key="ThemeSecondaryBrush" Color="LightBlue"/>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="ThemeForegroundBrush" Color="Black"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="Orange"/>
        <SolidColorBrush x:Key="ThemeSidebarBackgroundBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ThemeSidebarForegroundBrush" Color="Black"/>
    </Application.Resources>
</Application>
