<Window x:Class="SilvaShell.App.Views.ThemeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Manager" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Available Themes"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <ListView x:Name="ThemesListView"
                  Grid.Row="1"
                  SelectionMode="Single"
                  Margin="0,0,0,16">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" (Current)" Foreground="Green" Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Apply Selected" Width="100" Margin="0,0,8,0" Click="ApplyThemeButton_Click"/>
            <Button Content="Edit Selected" Width="100" Margin="0,0,8,0" Click="EditThemeButton_Click"/>
            <Button Content="Delete Selected" Width="110" Margin="0,0,8,0" Click="DeleteThemeButton_Click"/>
            <Button Content="Close" Width="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
