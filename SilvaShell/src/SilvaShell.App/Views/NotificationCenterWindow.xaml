<Window x:Class="SilvaShell.App.Views.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification Center" Height="600" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,8">
            <TextBlock Text="Notifications"
                       FontSize="16"
                       FontWeight="Bold"/>
            <TextBlock x:Name="UnreadCountText"
                       Text=" (0 unread)"
                       FontSize="14"
                       Foreground="Red"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <ListView x:Name="NotificationsListView"
                  Grid.Row="1"
                  Margin="16,0,16,16"
                  SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                            BorderBrush="#CCCCCC"
                            CornerRadius="4"
                            Margin="0,4"
                            Background="{Binding IsRead, Converter={StaticResource BoolToBackgroundConverter}}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                           FontSize="12"
                                           Foreground="Gray"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,4"
                                       FontSize="13"/>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding SourceApp}"
                                           FontSize="11"
                                           Foreground="#666666"/>
                                <TextBlock Text=" • "
                                           FontSize="11"
                                           Foreground="#666666"/>
                                <TextBlock Text="{Binding Type}"
                                           FontSize="11"
                                           Foreground="{Binding Type, Converter={StaticResource NotificationTypeToColorConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16">
            <Button Content="Mark Selected Read" Width="120" Margin="0,0,8,0" Click="MarkReadButton_Click"/>
            <Button Content="Mark All Read" Width="100" Margin="0,0,8,0" Click="MarkAllReadButton_Click"/>
            <Button Content="Clear All" Width="80" Click="ClearAllButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
